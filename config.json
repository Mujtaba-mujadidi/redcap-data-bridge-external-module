{
  "name": "RedcapDataBridge",
  "description": "Transmits mapped REDCap data to another project when an @RDB-MAP condition passes on survey completion",
  "namespace": "OxfordVaccineGroup\\RedcapDataBridge",
  "framework-version": 3,
  "permissions": [
    "redcap_survey_acknowledgement_page"
    
  ],
  "authors": [
    {
      "name": "Mujtaba Ghulam Farooq",
      "email": "mujtaba.farooq@paediatrics.ox.ac.uk",
      "institution": "Oxford Vaccine Group"
    }, 
    {
      "name": "Yama Mujadidi",
      "email": "yama.farooq@paediatrics.ox.ac.uk",
      "institution": "Oxford Vaccine Group"
    }
  ],
  "project-settings": [
    {
      "key": "api_url",
      "name": "Data Transmission URL",
      "required": true,
      "type": "text",
      "default": ""
    },
    {
      "key": "api_key",
      "name": "API Key",
      "required": true,
      "type": "password",
      "default": ""
    }
  ]
}
